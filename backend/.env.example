# Copy to backend/.env on the VPS (never commit real keys).
# Or export the same variables in your process manager / Docker Compose.

NODE_ENV=production
HOST=0.0.0.0
PORT=4000

# On Docker Compose this is overridden to use the postgres service hostname.
DATABASE_URL=postgres://incidentbridge:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/incidentbridge

MONITOR_INTERVAL_MS=2000
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=3

# Africa's Talking LIVE
AT_USERNAME=Thewton
AT_API_KEY=
AT_SENDER_ID=
AT_ALERT_PHONE=+256755032436

# Comma-separated origins, or * for any
CORS_ORIGIN=*
