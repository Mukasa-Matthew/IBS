# PostgreSQL
DATABASE_URL=postgres://incidentbridge:incidentbridge@localhost:5435/incidentbridge

# Backend
PORT=4000
MONITOR_INTERVAL_MS=2000
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=3

# Africa's Talking SMS + USSD
# Sandbox (dev): username is always sandbox. Paste the API key from the AT dashboard.
# Live: use the production app username and its API key.
# Leave AT_API_KEY empty to keep SMS in mock/SIMULATED mode.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# Phone registered in the AT sandbox simulator. Incident alerts and test SMS go here.
AT_ALERT_PHONE=+256787106109

# Frontend (Vite)
VITE_API_URL=
