# Local / shared defaults — copy to backend/.env for non-Docker runs.
# For VPS Docker Compose, put secrets in a root .env next to docker-compose.yml
# (Compose reads it automatically). Never commit real keys.

NODE_ENV=production
HOST=0.0.0.0
PORT=4000
API_PORT=4000
POSTGRES_PORT=5435
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

DATABASE_URL=postgres://incidentbridge:CHANGE_ME_STRONG_PASSWORD@localhost:5435/incidentbridge

MONITOR_INTERVAL_MS=2000
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=3

# Africa's Talking — use live app username + live API key on the VPS
# For AT USSD simulator locally: AT_USERNAME=sandbox + public tunnel to :4000
# See docs/africastalking-ussd-simulator.md
AT_USERNAME=Thewton
AT_API_KEY=
AT_SENDER_ID=
AT_ALERT_PHONE=+256755032436

CORS_ORIGIN=*

# Frontend (local only)
VITE_API_URL=
